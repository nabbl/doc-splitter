# Container paths, not discovered production host paths.
SPLIT_INBOX=/inbox
SPLIT_CONSUME=/handoff/consume
SPLIT_STAGING=/handoff/staging
SPLIT_ARCHIVE=/archive
SPLIT_REVIEW=/review
SPLIT_WORK=/work
SPLIT_STATE=/state
SPLIT_MODEL_CACHE=/models
SPLIT_MODEL_REVISION=dccadc69dd4ae69c63f42aa6715f249c6e5e6cf8
SPLIT_THRESHOLD=0.5
SPLIT_POLL_SECONDS=5
SPLIT_SETTLE_SECONDS=30
# settle: heuristic; atomic: uploader renames only after closing; marker: name.pdf.done.
SPLIT_COMPLETION_MODE=settle
SPLIT_OCR_LANGUAGES=deu+eng
SPLIT_OCR_TIMEOUT=120
SPLIT_BATCH_SIZE=2
SPLIT_THREADS=2
SPLIT_MAX_PAGES=128
SPLIT_MAX_SOURCE_MB=512
SPLIT_MAX_RENDER_PIXELS=16000000
SPLIT_RENDER_DPI=150
SPLIT_JOB_TIMEOUT=1800
SPLIT_MAX_ATTEMPTS=3
SPLIT_RETRY_SECONDS=30
SPLIT_HEARTBEAT_TIMEOUT=60
SPLIT_STARTUP_TIMEOUT=1800
SPLIT_DRY_RUN=false
# Opt in to deleting inbox copies only after durable handoff; archives are retained.
SPLIT_DELETE_COMPLETED_INPUTS=false
# Remove confidently blank duplex backs; preserve the untouched archived original.
SPLIT_REMOVE_BLANK_PAGES=false
# 0 disables review based on proximity to threshold. This is NOT a confidence guarantee.
SPLIT_REVIEW_MARGIN=0
